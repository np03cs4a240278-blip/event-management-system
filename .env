# ── Frontend API URL ──────────────────────────────────────────────────────────
# Points the React app to the PHP backend running in XAMPP.
# Change "event-management-system" if your XAMPP folder name is different.
REACT_APP_API_BASE_URL=http://localhost/event-management-system/backend/api
REACT_APP_API_PROJECT_FOLDER=event-management-system

# ── Database (MySQL via XAMPP) ────────────────────────────────────────────────
# Default XAMPP MySQL settings — change if yours differ.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=event_management_system
DB_USER=root
DB_PASSWORD=

# ── Gmail SMTP settings ───────────────────────────────────────────────────────
# Use a Gmail App Password if your account has 2FA enabled.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=khadkarabin9805@gmail.com
SMTP_PASSWORD=ekbterjmhlqhuksb
MAIL_FROM_NAME="Event Management System"
MAIL_FROM_ADDRESS=khadkarabin9805@gmail.com
MAIL_REPLY_TO=khadkarabin9805@gmail.com
