# If your XAMPP project folder has a different name, update this URL to match it.
REACT_APP_API_BASE_URL=http://localhost/event-management-system/backend/api
# Optional fallback when REACT_APP_API_BASE_URL is not set.
REACT_APP_API_PROJECT_FOLDER=event-management-system

# ---- Backend SMTP settings for real email delivery ----
# Use Gmail SMTP with an app password if your Google account has 2FA enabled.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=your@gmail.com
SMTP_PASSWORD=your_gmail_app_password
MAIL_FROM_NAME="Event Management System"
MAIL_FROM_ADDRESS=your@gmail.com
MAIL_REPLY_TO=your@gmail.com

# Optional debugging flags
# Keep these false in normal use. Enable only for local testing.
MAIL_ALLOW_PHP_FALLBACK=false
OTP_LOG_CODES=false
